# TRINETRA environment configuration (copy to backend/.env — never commit real secrets)

# sqlite:///./drishti.db   (demo default)
# postgresql+psycopg://user:pass@localhost:5432/drishti
DATABASE_URL=sqlite:///./drishti.db

APP_ENV=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5317,http://localhost:5199

MODEL_VERSION=iforest-v1
RULESET_VERSION=rules-v1
REPORT_STORAGE_PATH=./reports

# Auto-load the deterministic demo dataset when the database is empty.
DEMO_AUTOSEED=true

# Auth (backlog security pack). SECRET_KEY must be a long random value in
# production; session tokens are HMAC-signed with it, rotating it revokes all.
SESSION_TTL_HOURS=8

# Set false in production to disable the seeded stakeholder demo accounts.
DEMO_ACCOUNTS_ENABLED=true
